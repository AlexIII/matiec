FUNCTION_BLOCK FB1
  VAR
    X : STRING[10];
  END_VAR
  LD X
  ST X
END_FUNCTION_BLOCK

PROGRAM prog0
  VAR
    F : FB1;
  END_VAR
  F();
END_PROGRAM

CONFIGURATION config
  RESOURCE res ON PLC
    TASK tsk(INTERVAL := T#100ms, PRIORITY := 0);
    PROGRAM inst0 WITH tsk : prog0;
  END_RESOURCE
END_CONFIGURATION
