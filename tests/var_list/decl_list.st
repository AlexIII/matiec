TYPE PAIR : STRUCT
  A : UDINT;
  B : INT;
END_STRUCT; END_TYPE

FUNCTION_BLOCK FB1
  VAR
    T1, T2, T3 : TON;
  END_VAR
  T1(IN := TRUE, PT := T#1s);
END_FUNCTION_BLOCK

PROGRAM prog0
  VAR
    F : FB1;
    G1, G2, G3 : FB1;
    S1, S2, S3 : PAIR;
    N : INT;
  END_VAR
  F();
  N := N + 1;
END_PROGRAM

CONFIGURATION cfg
  RESOURCE res ON PLC
    TASK t(INTERVAL := T#10ms, PRIORITY := 0);
    PROGRAM inst WITH t : prog0;
  END_RESOURCE
END_CONFIGURATION
